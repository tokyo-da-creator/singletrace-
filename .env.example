# SignalTrace environment. Copy to .env and fill in only the keys you have.
# Never commit .env. None of these values are sent to the browser.

# PostgreSQL connection string. Leave unset to use embedded PostgreSQL
# (PGlite) in ./data/pglite. Use a real server for any shared deployment.
# DATABASE_URL=postgres://signaltrace:password@localhost:5432/signaltrace

# abuse.ch Auth-Key. Optional for the public ThreatFox and URLhaus CSV
# exports used by collection. Required for live indicator lookups against
# the ThreatFox API. Create one at https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# GreyNoise Community API key. Investigation lookups are skipped without it.
# https://viz.greynoise.io/signup
# https://docs.greynoise.io/docs/using-the-greynoise-community-api
GREYNOISE_API_KEY=

# NIST NVD API key. CVE lookups work without it at the public rate limit
# of 5 requests per 30 seconds. A key raises that to 50.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Shared secret required by POST /api/v1/ingest. Leave unset to disable
# HTTP-triggered collection. The CLI `npm run ingest` does not use this.
INGEST_SECRET=

# Minutes between scheduled collection runs inside the Next.js server.
# 0 disables the scheduler. Minimum enforced interval is 10 minutes.
# Prefer an external cron in production.
INGEST_INTERVAL_MINUTES=0

# Set to 1 to collect shortly after the server process starts.
INGEST_ON_START=0

# Maximum new public-IP geolocations per collection run.
# ip-api.com free tier is non-commercial, HTTP, and rate limited.
GEO_MAX_PER_RUN=400
